# FPT AI Factory – lấy API key tại https://factory.fpt.ai
FPT_API_KEY=your_api_key_here
FPT_BASE_URL=https://mkp-api.fptcloud.com/v1

# Tên model (đúng tên hiển thị trên FPT AI Factory dashboard)
FPT_EMBEDDING_MODEL=vietnamese-embedding
FPT_SPARSE_MODEL=vietnamese-embedding
FPT_LLM_MODEL=Qwen3-32B

# Retrieval config
TOP_K_DENSE=100
TOP_K_BM25=100
TOP_K_FINAL=10
EMBEDDING_DIM=1024

# Paths (có thể để mặc định)
DATA_DIR=data
INDEX_DIR=indexes
CHECKPOINT_DIR=checkpoints
RESULTS_DIR=results
